# Copy this file to configs/hosts.env and set the shared paths.
# Do not commit configs/hosts.env.

TAMOE_HOSTS="doraemon02,doraemon03,doraemon04,doraemon15,doraemon19,doraemon20"

# The repository, data, and run roots should resolve to shared-disk paths
# visible from every Linux host. The agent must verify this before dispatch.
TAMOE_PROJECT_ROOT="/shared/path/to/test"
TAMOE_DATA_ROOT="/shared/path/to/tamoe_data"
TAMOE_RUN_ROOT="/shared/path/to/tamoe_runs"
TAMOE_CACHE_ROOT="/shared/path/to/tamoe_cache"

# Optional host-local scratch. Use only for disposable caches, never as the
# single location of checkpoints or final metrics.
TAMOE_LOCAL_SCRATCH="/tmp/${USER}/tamoe"

# Conservative defaults; the agent may override per host after probing.
TAMOE_NUM_WORKERS="4"
TAMOE_SEED="20260805"
